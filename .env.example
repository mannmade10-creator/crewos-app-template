# ── Business Identity ────────────────────────────────────────────────────────
# These are set by Sam (DevOps) via app_build_env_set after each deployment.
# Replace every value below with the client's real info.

NEXT_PUBLIC_BUSINESS_NAME="Acme Co"
NEXT_PUBLIC_BUSINESS_TAGLINE="We make things happen."
NEXT_PUBLIC_BUSINESS_DESCRIPTION="A short sentence about what this business does and who it serves."
NEXT_PUBLIC_BUSINESS_PHONE="+1 (555) 000-0000"
NEXT_PUBLIC_BUSINESS_EMAIL="hello@example.com"
NEXT_PUBLIC_BUSINESS_ADDRESS="123 Main St, Oklahoma City, OK 73101"
NEXT_PUBLIC_BUSINESS_TYPE="service"   # service | ecommerce | saas

# ── Brand Colors (CSS custom properties — hex values) ─────────────────────
NEXT_PUBLIC_BRAND_50="#f0f9ff"
NEXT_PUBLIC_BRAND_100="#e0f2fe"
NEXT_PUBLIC_BRAND_500="#0ea5e9"
NEXT_PUBLIC_BRAND_600="#0284c7"
NEXT_PUBLIC_BRAND_700="#0369a1"
NEXT_PUBLIC_BRAND_900="#0c4a6e"

# ── Services / Offerings (pipe-separated, max 6) ──────────────────────────
NEXT_PUBLIC_SERVICE_1="Service One|A short description of this service."
NEXT_PUBLIC_SERVICE_2="Service Two|A short description of this service."
NEXT_PUBLIC_SERVICE_3="Service Three|A short description of this service."
NEXT_PUBLIC_SERVICE_4=""
NEXT_PUBLIC_SERVICE_5=""
NEXT_PUBLIC_SERVICE_6=""

# ── Social Links (leave blank to hide) ───────────────────────────────────
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_FACEBOOK=""
NEXT_PUBLIC_SOCIAL_TIKTOK=""
NEXT_PUBLIC_SOCIAL_TWITTER=""

# ── CrewOS Backend (set server-side only — never NEXT_PUBLIC_) ────────────
# The workspace's Supabase project — used to store leads and bookings.
CREWOS_SUPABASE_URL="https://your-project.supabase.co"
CREWOS_SUPABASE_SERVICE_KEY="eyJh..."
CREWOS_WORKSPACE_ID="your-workspace-uuid"

# ── Booking / Email Notifications (Resend) ────────────────────────────────
# When RESEND_API_KEY is set, the "Book an Appointment" tab appears on the
# contact section and the business owner gets an email for each new booking.
RESEND_API_KEY="re_..."
BUSINESS_OWNER_EMAIL="owner@example.com"
BOOKING_FROM_EMAIL="noreply@notifications.crewwos.com"

# ── Google Calendar (optional — for future calendar sync) ─────────────────
# Leave blank unless Google Calendar integration is configured.
CREWOS_GCAL_ACCESS_TOKEN=""
CREWOS_GCAL_REFRESH_TOKEN=""
CREWOS_GCAL_CALENDAR_ID="primary"
CREWOS_GCAL_TIMEZONE="America/Chicago"
